NEXT_PUBLIC_FIREBASE_API_KEY=PASTE_MY_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=habeshagramweb.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=habeshagramweb
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=habeshagramweb.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=574133465888
NEXT_PUBLIC_FIREBASE_APP_ID=1:574133465888:web:41672c4f0c07b1d0d05d45
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional server-only overrides for the Breaking Now RSS feed.
# When blank, HabeshaGram uses BBC Africa RSS.
BREAKING_NEWS_RSS_URL=
BREAKING_NEWS_RSS_URLS=
# Admin-only content seeding credential
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=
# Server-only allowlists for the internal admin workspace
ADMIN_EMAIL_ALLOWLIST=
ADMIN_UID_ALLOWLIST=

# ─── Live Rooms — LiveKit audio provider (server-side secrets ONLY) ───────────
# Sign up at https://livekit.io and create a project to get these values.
# NEVER prefix these with NEXT_PUBLIC_ — they must stay server-only.
# LIVEKIT_URL is the WebSocket server URL returned to the mobile app.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud

# ── AI features (World News digest + story summaries) ────────────────
# Configure ONE of these. Anthropic (Claude) gives the best quality;
# Google Gemini has a free tier. Restart the dev server after adding.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional: override the default model (claude-haiku-4-5 / gemini-3.5-flash)
AI_MODEL=
