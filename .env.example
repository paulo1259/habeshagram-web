# ─── Supabase (auth + database) ───────────────────────────────────────────────
# Both values are safe to expose in the browser. The publishable key grants
# nothing on its own — Row Level Security decides what each user may read.
# Find them in the Supabase dashboard under Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Site origin ──────────────────────────────────────────────────────────────
# Used for canonical URLs, the sitemap, robots.txt and share cards.
# Leave blank: dev falls back to http://localhost:3000, and any production
# build falls back to https://habeshagram.today. Set it only to point a
# deployment somewhere else.
NEXT_PUBLIC_SITE_URL=

# ─── Analytics (optional) ─────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Breaking news feed (optional, server-only) ───────────────────────────────
# Leave blank. Blank falls through to the BBC Africa world feed, which is what
# you want. These previously pointed at BBC Sport football by mistake.
BREAKING_NEWS_RSS_URL=
BREAKING_NEWS_RSS_URLS=

# ─── AI features (World News digest) ──────────────────────────────────────────
# Configure ONE. Anthropic gives the best quality; Gemini has a free tier.
# Restart the dev server after adding.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional: override the default model (claude-haiku-4-5 / gemini-3.5-flash)
AI_MODEL=
