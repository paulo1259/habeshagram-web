{
  "name": "habeshagram-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); ['.next','tsconfig.tsbuildinfo'].forEach((path)=>fs.rmSync(path,{ recursive:true, force:true }))\"",
    "dev": "npm run clean && next dev",
    "dev:reset": "npm run clean && next dev",
    "build": "npm run clean && next build",
    "build:clean": "npm run clean && next build",
    "start": "next start",
    "lint": "node -e \"console.log('Lint is optional for this MVP.')\"",
    "seed:content": "node --env-file=.env.local scripts/seed-content.mjs"
  },
  "engines": {
    "node": ">=20.11 <23"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^11.0.2",
    "firebase-admin": "^13.8.0",
    "livekit-server-sdk": "^2.9.0",
    "lucide-react": "^0.468.0",
    "next": "14.2.16",
    "posthog-js": "^1.372.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
}
